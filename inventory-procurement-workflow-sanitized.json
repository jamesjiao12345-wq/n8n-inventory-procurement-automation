    {
      "parameters": {
        "jsCode": "// === Parse AI Agent1 output into one item per low-stock SKU ===\n\nconst raw = $input.first().json.output;\n\nif (raw === undefined || raw === null) {\n  throw new Error('AI Agent1 returned no \"output\" field. Check the agent node ran successfully.');\n}\n\n// Strip ```json ... ``` fences in case the model wrapped the JSON despite instructions\nlet cleaned = String(raw).trim();\ncleaned = cleaned.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  throw new Error(\n    `Failed to parse AI Agent1 output as JSON: ${err.message}\\n---raw output---\\n${cleaned}`\n  );\n}\n\n// Basic shape validation\nif (typeof parsed !== 'object' || parsed === null) {\n  throw new Error('Parsed AI Agent1 output is not an object.');\n}\n\nconst lowStockItems = Array.isArray(parsed.low_stock_items) ? parsed.low_stock_items : [];\nconst skippedItems = Array.isArray(parsed.skipped_items) ? parsed.skipped_items : [];\n\nif (skippedItems.length > 0) {\n  // Not fatal — just visible in the execution log for debugging\n  console.log('Skipped items (missing Reorder threshold):', JSON.stringify(skippedItems));\n}\n\nif (!parsed.needs_reorder || lowStockItems.length === 0) {\n  // Nothing to reorder — return no items so downstream nodes don't run\n  return [];\n}\n\n// Emit one item per SKU, with normalized field names for Email Supplier\nreturn lowStockItems\n  .filter(item => item && item.supplier_email) // skip anything with no email to send to\n  .map(item => ({\n    json: {\n      sku: item.SKU ?? '',\n      product_name: item['Product Name'] ?? '',\n      current_stock: item.current_stock ?? null,\n      threshold: item.threshold ?? null,\n      order_quantity: item.order_quantity ?? item.threshold ?? null,\n      supplier_name: item.supplier_name ?? '',\n      supplier_email: item.supplier_email\n    }\n  }));"
      },
