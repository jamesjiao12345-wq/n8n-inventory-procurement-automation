        "message": "=Hello {{ $json.supplier_name }},<br><br>\nWe require stock for <b>{{ $json.product_name }}</b>. We require {{ $json.order_quantity }} units.<br>\nKindly share quotation for the same.<br>\nThanks.",
        "options": {}
